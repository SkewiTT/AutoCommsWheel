<Window x:Class="AutoCommsWheel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoCommsWheel"
        mc:Ignorable="d"
        Title="MainWindow"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStyle="None" ResizeMode="NoResize"
        Loaded="MainWindow_Loaded"
        Closed="MainWindow_Closed"
        Left="0" Top="0"
        Width="{x:Static SystemParameters.PrimaryScreenWidth}"
        Height="{x:Static SystemParameters.PrimaryScreenHeight}"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        Focusable="False"
        >
    <!-- We manually set the window size as showActivated beinf false conflicts with WindowState="Maximized" as that tries to activate the window. -->
    <Grid>
        <Canvas x:Name="WheelCanvas">
        </Canvas>
    </Grid>
</Window>
