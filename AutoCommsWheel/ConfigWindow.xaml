<Window x:Class="AutoCommsWheel.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoCommsWheel"
        mc:Ignorable="d"
        Title="ConfigWindow" Height="318" Width="450" ResizeMode="NoResize">
    <Grid>
        <TextBox x:Name="ConfigKeyBind" HorizontalAlignment="Left" Margin="180,15,0,0" TextWrapping="Wrap" VerticalAlignment="Top" MaxLength="1" Width="40" Loaded="ConfigKeyBind_Loaded" PreviewKeyDown="ConfigKeyBind_KeyEntered"/>
        <Label x:Name="ConfigKeyLabel" Content="Keybind to open this window" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"/>
        <ListBox x:Name="WheelsListBox" d:ItemsSource="{d:SampleData ItemCount=5}" DisplayMemberPath="FileName" Margin="16,118,0,0" VerticalAlignment="Top" Width="200" Height="120" HorizontalAlignment="Left"/>
        <TextBlock HorizontalAlignment="Left" Margin="16,46,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="72" Width="379"><Run Text="This app renders "/><Run Text="communication "/><Run Text="wheels using"/><Run Text=" JSON files. from the root define an object with an array inside, each object of the array will be a section of the wheel. you can make a subsection by defining "/><Run Text="sub"/><Run Language="en-gb" Text=":"/><Run Text=" in the object"/><Run Text=" and "/><Run Text="adding another "/><Run Text="array of "/><Run Text="sub"/><Run Text="sec"/><Run Text="t"/><Run Text="ions"/><Run Text="."/></TextBlock>
        <Button x:Name="BtnImportCommunicationWheel" Content="&#xE896;" HorizontalAlignment="Left" Margin="221,118,0,0" VerticalAlignment="Top" Width="25" Height="25" FontFamily="Segoe MDL2 Assets" Padding="0,0,0,0" FontSize="16" Click="BtnImportCommunicationWheel_Click"/>
    </Grid>
</Window>
