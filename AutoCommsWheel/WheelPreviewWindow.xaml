<Window x:Class="AutoCommsWheel.WheelPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoCommsWheel"
        mc:Ignorable="d"
        Title="WheelPreview" Height="900" Width="1600"
        ResizeMode="NoResize">
    <Grid>
        <TreeView x:Name="WheelPreviewTreeView" >
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type local:WheelNode}" ItemsSource="{Binding Subsections}">
                    <TextBlock>                
                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="  →  "/>
                        <Run Text="{Binding Text, Mode=OneWay}"/>
                    </TextBlock>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

    </Grid>
</Window>
